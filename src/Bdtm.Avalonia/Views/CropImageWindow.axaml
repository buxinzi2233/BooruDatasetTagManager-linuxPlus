<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bdtm.Avalonia.ViewModels"
        xmlns:ctrl="using:Bdtm.Avalonia.Controls"
        x:Class="Bdtm.Avalonia.Views.CropImageWindow"
        x:DataType="vm:CropImageViewModel"
        Width="1000" Height="700"
        MinWidth="720" MinHeight="480"
        Title="裁剪图像"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
  <DockPanel Margin="10">
    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,0,0,8">
      <Button Content="导出并导入"
              Click="Export_Click"
              MinWidth="110"
              Padding="14,7"
              FontWeight="SemiBold" />
      <Button Content="删除选区"
              Click="Delete_Click"
              MinWidth="90"
              Padding="12,7" />
      <Button Content="取消"
              Click="Cancel_Click"
              MinWidth="80"
              Padding="12,7" />
      <TextBlock Text="比例/尺寸"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0"
                 Opacity="0.85" />
      <ComboBox Width="168"
                ItemsSource="{Binding AspectPresets}"
                SelectedItem="{Binding SelectedAspectPreset}"
                DisplayMemberBinding="{Binding Name}"
                VerticalAlignment="Center" />
      <TextBlock Text="{Binding FileName}"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0"
                 Opacity="0.85" />
      <TextBlock Text="{Binding StatusMessage}"
                 VerticalAlignment="Center"
                 Margin="16,0,0,0"
                 Opacity="0.9"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- Right region list -->
    <Border DockPanel.Dock="Right"
            Width="200"
            Margin="10,0,0,0"
            BorderBrush="#3f3f46"
            BorderThickness="1"
            Padding="8"
            Background="#252526">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="区域列表"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Delete 删除 · Esc 取消"
                   Opacity="0.6"
                   FontSize="11"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />
        <ListBox x:Name="RegionList"
                 ItemsSource="{Binding RegionItems}"
                 SelectionChanged="RegionList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CropRegionListItem">
              <TextBlock Text="{Binding DisplayText}" Margin="2,4" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Canvas -->
    <Border BorderBrush="#3f3f46"
            BorderThickness="1"
            Background="#1e1e1e"
            ClipToBounds="True">
      <ctrl:CropCanvasControl x:Name="Canvas"
                              Regions="{Binding Regions}"
                              SelectedRegion="{Binding SelectedRegion, Mode=TwoWay}"
                              ImagePixelWidth="{Binding ImageWidth}"
                              ImagePixelHeight="{Binding ImageHeight}"
                              AspectPreset="{Binding SelectedAspectPreset}" />
    </Border>
  </DockPanel>
</Window>
