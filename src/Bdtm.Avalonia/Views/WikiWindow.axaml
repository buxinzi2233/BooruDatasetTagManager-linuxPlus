<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bdtm.Avalonia.ViewModels"
        x:Class="Bdtm.Avalonia.Views.WikiWindow"
        x:DataType="vm:WikiViewModel"
        Width="680" Height="560"
        MinWidth="480" MinHeight="360"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="浏览器打开" Command="{Binding OpenInBrowserCommand}" MinWidth="100" />
      <Button Content="关闭" Click="Close_Click" MinWidth="88" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Meta}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
      <TextBlock Text="加载中…" IsVisible="{Binding IsLoading}" Opacity="0.8" />
    </StackPanel>

    <TextBox Text="{Binding Body}"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalContentAlignment="Top" />
  </DockPanel>
</Window>
