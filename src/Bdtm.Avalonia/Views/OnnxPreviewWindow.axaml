<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bdtm.Avalonia.ViewModels"
        x:Class="Bdtm.Avalonia.Views.OnnxPreviewWindow"
        x:DataType="vm:OnnxPreviewViewModel"
        Width="560" Height="640"
        MinWidth="420" MinHeight="400"
        Title="ONNX 打标预览"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="全选" Command="{Binding SelectAllCommand}" />
      <Button Content="全不选" Command="{Binding SelectNoneCommand}" />
      <Button Content="应用选中" Click="Apply_Click" MinWidth="96" FontWeight="SemiBold" />
      <Button Content="取消" Click="Cancel_Click" MinWidth="88" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding ImageName}" TextTrimming="CharacterEllipsis" />
      <TextBlock Opacity="0.8" Text="{Binding Summary}" />
      <TextBlock Opacity="0.8" Text="{Binding WriteModeText, StringFormat=写入模式: {0}}" />
      <TextBlock Opacity="0.65" FontSize="12" Text="取消则不写入任何标签。批量打标仍直接写入（可在后续版本统一预览）。" TextWrapping="Wrap" />
    </StackPanel>

    <DataGrid ItemsSource="{Binding Tags}"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected}" Width="48" />
        <DataGridTextColumn Header="标签" Binding="{Binding Tag}" Width="2*" IsReadOnly="True" />
        <DataGridTextColumn Header="中文" Binding="{Binding Chinese}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="置信度" Binding="{Binding Confidence}" Width="80" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
