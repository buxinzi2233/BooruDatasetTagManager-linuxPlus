<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bdtm.Avalonia.ViewModels"
        x:Class="Bdtm.Avalonia.Views.OnnxPreviewWindow"
        x:DataType="vm:OnnxPreviewViewModel"
        Width="720" Height="700"
        MinWidth="560" MinHeight="480"
        Title="ONNX 打标预览"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True">
  <DockPanel Margin="16">
    <!-- Bottom actions: full width, clear padding so not clipped -->
    <Border DockPanel.Dock="Bottom"
            Margin="0,12,0,0"
            Padding="0,10,0,0"
            BorderBrush="#3f3f46"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding SelectedCountText}"
                   VerticalAlignment="Center"
                   Opacity="0.8"
                   Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button Content="全选" Command="{Binding SelectAllCommand}" MinWidth="72" Padding="12,6" />
          <Button Content="全不选" Command="{Binding SelectNoneCommand}" MinWidth="72" Padding="12,6" />
          <Button Content="应用选中" Click="Apply_Click" MinWidth="100" Padding="14,6" FontWeight="SemiBold" />
          <Button Content="取消" Click="Cancel_Click" MinWidth="80" Padding="12,6" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
      <TextBlock FontSize="16" FontWeight="SemiBold"
                 Text="{Binding ImageName}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding ImageName}" />
      <TextBlock Opacity="0.85" Text="{Binding Summary}" TextWrapping="Wrap" />
      <TextBlock Opacity="0.85" Text="{Binding WriteModeText, StringFormat=写入模式: {0}}" />
      <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                 Text="勾选要写入的标签后点「应用选中」。取消则不写入。多图批量仍直接写入。" />
    </StackPanel>

    <DataGrid ItemsSource="{Binding Tags}"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="False"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              SelectionMode="Single"
              RowHeight="30"
              ColumnHeaderHeight="34"
              BorderThickness="1"
              BorderBrush="#3f3f46">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="选用"
                                Binding="{Binding IsSelected, Mode=TwoWay}"
                                Width="56"
                                MinWidth="56" />
        <DataGridTextColumn Header="标签"
                            Binding="{Binding Tag}"
                            Width="2.2*"
                            MinWidth="140"
                            IsReadOnly="True" />
        <DataGridTextColumn Header="中文"
                            Binding="{Binding Chinese}"
                            Width="*"
                            MinWidth="96"
                            IsReadOnly="True" />
        <DataGridTextColumn Header="置信度"
                            Binding="{Binding ConfidenceText}"
                            Width="96"
                            MinWidth="96"
                            IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
