<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bdtm.Avalonia.ViewModels"
        xmlns:onnx="using:Bdtm.Onnx"
        x:Class="Bdtm.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="640"
        Title="Booru Dataset Tag Manager (Linux)">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="打开数据集文件夹…" Command="{Binding OpenFolderCommand}" />
        <MenuItem Header="保存标签" Command="{Binding SaveCommand}" />
        <Separator />
        <MenuItem Header="保存设置" Command="{Binding SaveSettingsCommand}" />
      </MenuItem>
      <MenuItem Header="打标(_T)">
        <MenuItem Header="ONNX 打标当前图" Command="{Binding RunOnnxOnCurrentCommand}" />
        <MenuItem Header="刷新 ONNX 状态" Command="{Binding RefreshOnnxStatusUiCommand}" />
      </MenuItem>
      <MenuItem Header="视图(_V)">
        <MenuItem Header="显示完整路径" ToggleType="CheckBox" IsChecked="{Binding ShowPaths}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#1e1e1e">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ProviderText}" Margin="12,0,0,0" Opacity="0.8" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="300,*,340" Margin="8">
      <!-- Left: dataset with thumbnails -->
      <DockPanel Margin="0,0,8,0">
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,6"
                   Text="{Binding DatasetPath, StringFormat=数据集: {0}}" TextTrimming="CharacterEllipsis" />
        <ListBox ItemsSource="{Binding Images}"
                 SelectedItem="{Binding SelectedImage}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ImageListItem">
              <Grid ColumnDefinitions="72,*" Margin="2">
                <Border Width="64" Height="64" Background="#333" CornerRadius="3" ClipToBounds="True">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Path}"
                             IsVisible="{Binding ShowFullPath}"
                             Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Path}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Center: tags + preview -->
      <Grid Grid.Column="1" RowDefinitions="*,220" Margin="0,0,8,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBox Width="200" Watermark="新标签" Text="{Binding NewTagText}" />
            <Button Content="添加" Command="{Binding AddTagCommand}" />
            <Button Content="删除选中" Command="{Binding RemoveSelectedTagCommand}" CommandParameter="{Binding SelectedTag}" />
            <Button Content="保存" Command="{Binding SaveCommand}" />
            <Button Content="ONNX 当前图" Command="{Binding RunOnnxOnCurrentCommand}" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding CurrentTags}"
                    SelectedItem="{Binding SelectedTag}"
                    AutoGenerateColumns="False"
                    IsReadOnly="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="标签" Binding="{Binding Tag}" Width="2*" />
              <DataGridTextColumn Header="中文" Binding="{Binding Chinese}" Width="*" IsReadOnly="True" />
              <DataGridTextColumn Header="权重" Binding="{Binding Weight}" Width="70" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,8,0,0" Background="#252526" CornerRadius="4" Padding="6">
          <Grid ColumnDefinitions="*,180">
            <Border Background="#111" CornerRadius="3" ClipToBounds="True">
              <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4">
              <TextBlock FontWeight="Bold" Text="预览" />
              <TextBlock Text="{Binding SelectedImage.Name, FallbackValue=''}" TextWrapping="Wrap" Opacity="0.9" />
              <TextBlock Text="{Binding SelectedImage.Path, FallbackValue=''}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Right: ONNX + global tags table -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Padding="8" Margin="0,0,0,8" Background="#252526" CornerRadius="4">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="Bold" Text="ONNX 设置" />
            <TextBox Watermark="模型 repo" Text="{Binding OnnxModelRepo}" />
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel>
                <TextBlock Text="General 阈值" Opacity="0.8" />
                <NumericUpDown Minimum="0" Maximum="1" Increment="0.01"
                               Value="{Binding GeneralThreshold}" FormatString="0.00" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Character 阈值" Opacity="0.8" />
                <NumericUpDown Minimum="0" Maximum="1" Increment="0.01"
                               Value="{Binding CharacterThreshold}" FormatString="0.00" />
              </StackPanel>
            </Grid>
            <ComboBox SelectedItem="{Binding WriteMode}">
              <onnx:TagWriteMode>AppendNew</onnx:TagWriteMode>
              <onnx:TagWriteMode>ReplaceAll</onnx:TagWriteMode>
            </ComboBox>
            <TextBlock Text="{Binding ProviderText}" Opacity="0.9" TextWrapping="Wrap" FontSize="12" />
            <Button Content="刷新模型状态" Command="{Binding RefreshOnnxStatusUiCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock FontWeight="Bold" Text="全局标签" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="添加到当前" Command="{Binding AddGlobalTagToCurrentCommand}" />
          </Grid>
          <DataGrid ItemsSource="{Binding GlobalTags}"
                    SelectedItem="{Binding SelectedGlobalTag}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="标签" Binding="{Binding Tag}" Width="2*" />
              <DataGridTextColumn Header="中文" Binding="{Binding Chinese}" Width="*" />
              <DataGridTextColumn Header="计数" Binding="{Binding Count}" Width="60" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
