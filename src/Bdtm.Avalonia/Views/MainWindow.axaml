<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bdtm.Avalonia.ViewModels"
        xmlns:onnx="using:Bdtm.Onnx"
        x:Class="Bdtm.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="640"
        Title="Booru Dataset Tag Manager (Linux)">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="打开数据集文件夹…" Command="{Binding OpenFolderCommand}" />
        <MenuItem Header="保存标签" Command="{Binding SaveCommand}" />
        <Separator />
        <MenuItem Header="保存设置" Command="{Binding SaveSettingsCommand}" />
      </MenuItem>
      <MenuItem Header="打标(_T)">
        <MenuItem Header="ONNX 打标当前图" Command="{Binding RunOnnxOnCurrentCommand}" />
        <MenuItem Header="ONNX 打标选中图" Command="{Binding RunOnnxOnSelectedCommand}" />
        <MenuItem Header="ONNX 打标全部" Command="{Binding RunOnnxOnAllCommand}" />
        <MenuItem Header="取消批量" Command="{Binding CancelBatchCommand}" />
        <Separator />
        <MenuItem Header="刷新 ONNX 状态" Command="{Binding RefreshOnnxStatusUiCommand}" />
      </MenuItem>
      <MenuItem Header="视图(_V)">
        <MenuItem Header="显示完整路径" ToggleType="CheckBox" IsChecked="{Binding ShowPaths}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#1e1e1e">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Width="160" Height="12" Margin="12,0"
                     Minimum="0" Maximum="100" Value="{Binding BatchProgress}"
                     IsVisible="{Binding IsBatchRunning}" />
        <TextBlock Grid.Column="2" Text="{Binding ProviderText}" Margin="12,0,0,0" Opacity="0.8" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="300,*,360" Margin="8">
      <!-- Left -->
      <DockPanel Margin="0,0,8,0">
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,6"
                   Text="{Binding DatasetPath, StringFormat=数据集: {0}}" TextTrimming="CharacterEllipsis" />
        <ListBox x:Name="ImageList"
                 ItemsSource="{Binding Images}"
                 SelectedItem="{Binding SelectedImage}"
                 SelectionMode="Multiple"
                 SelectionChanged="ImageList_OnSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ImageListItem">
              <Grid ColumnDefinitions="72,*" Margin="2">
                <Border Width="64" Height="64" Background="#333" CornerRadius="3" ClipToBounds="True">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Path}"
                             IsVisible="{Binding ShowFullPath}"
                             Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Path}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Center: tags -->
      <DockPanel Grid.Column="1" Margin="0,0,8,0">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="180" Watermark="新标签" Text="{Binding NewTagText}" />
            <Button Content="添加" Command="{Binding AddTagCommand}" />
            <Button Content="删除" Command="{Binding RemoveSelectedTagRowsCommand}" />
            <Button Content="上移" Command="{Binding MoveTagUpCommand}" />
            <Button Content="下移" Command="{Binding MoveTagDownCommand}" />
            <Button Content="保存" Command="{Binding SaveCommand}" />
            <Button Content="ONNX 当前" Command="{Binding RunOnnxOnCurrentCommand}" />
            <Button Content="ONNX 全部" Command="{Binding RunOnnxOnAllCommand}" />
            <Button Content="取消批量" Command="{Binding CancelBatchCommand}"
                    IsVisible="{Binding IsBatchRunning}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Watermark="过滤当前标签（英文/中文）" Text="{Binding CurrentTagFilter}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7"
                       Text="{Binding BatchStatus}" />
          </Grid>
        </StackPanel>
        <DataGrid ItemsSource="{Binding FilteredCurrentTags}"
                  SelectedItem="{Binding SelectedTag}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn Header="标签" Binding="{Binding Tag}" Width="2*" />
            <DataGridTextColumn Header="中文" Binding="{Binding Chinese}" Width="*" IsReadOnly="True" />
            <DataGridTextColumn Header="权重" Binding="{Binding Weight}" Width="70" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- Right -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Padding="8" Margin="0,0,0,8" Background="#252526" CornerRadius="4">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="Bold" Text="ONNX 设置" />
            <TextBox Watermark="模型 repo" Text="{Binding OnnxModelRepo}" />
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel>
                <TextBlock Text="General 阈值" Opacity="0.8" />
                <NumericUpDown Minimum="0" Maximum="1" Increment="0.01"
                               Value="{Binding GeneralThreshold}" FormatString="0.00" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Character 阈值" Opacity="0.8" />
                <NumericUpDown Minimum="0" Maximum="1" Increment="0.01"
                               Value="{Binding CharacterThreshold}" FormatString="0.00" />
              </StackPanel>
            </Grid>
            <ComboBox SelectedItem="{Binding WriteMode}">
              <onnx:TagWriteMode>AppendNew</onnx:TagWriteMode>
              <onnx:TagWriteMode>ReplaceAll</onnx:TagWriteMode>
            </ComboBox>
            <TextBlock Text="{Binding ProviderText}" Opacity="0.9" TextWrapping="Wrap" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="ONNX 全部" Command="{Binding RunOnnxOnAllCommand}" />
              <Button Content="刷新状态" Command="{Binding RefreshOnnxStatusUiCommand}" />
            </StackPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding BatchProgress}"
                         Height="8" IsVisible="{Binding IsBatchRunning}" />
          </StackPanel>
        </Border>

        <TabControl>
          <TabItem Header="全局标签">
            <DockPanel Margin="0,6,0,0">
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto" Margin="0,0,0,6">
                <TextBox Watermark="过滤全局标签（英文/中文）" Text="{Binding GlobalTagFilter}" />
                <Button Grid.Column="2" Content="添加到当前" Command="{Binding AddGlobalTagToCurrentCommand}" />
              </Grid>
              <DataGrid ItemsSource="{Binding FilteredGlobalTags}"
                        SelectedItem="{Binding SelectedGlobalTag}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="Horizontal"
                        SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="标签" Binding="{Binding Tag}" Width="2*" />
                  <DataGridTextColumn Header="中文" Binding="{Binding Chinese}" Width="*" />
                  <DataGridTextColumn Header="计数" Binding="{Binding Count}" Width="60" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem Header="预览">
            <DockPanel Margin="0,6,0,0">
              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="2">
                <TextBlock Text="{Binding SelectedImage.Name, FallbackValue=''}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedImage.Path, FallbackValue=''}"
                           FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
              </StackPanel>
              <Border Background="#111" CornerRadius="4" ClipToBounds="True" MinHeight="200">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
              </Border>
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
